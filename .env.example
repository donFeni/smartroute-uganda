# SmartRoute Uganda — Environment Configuration Example
#
# DO NOT commit real credentials to source control.
# These values are injected at build time via --dart-define.
# They are NOT secrets — they ship in compiled binaries. Do not use
# server-side secrets here; rotate keys if accidentally exposed.
#
# Usage:
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ... \
#     --dart-define=ORS_API_KEY=your_ors_key \
#     --dart-define=ENVIRONMENT=development
#
# When a key is absent, the app uses a labelled DEMO fallback.
# DO NOT silently fall back to fake results without labelling.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# ─── Routing ───────────────────────────────────────────────────────────────────
# Get from: https://openrouteservice.org (free tier available)
# Free tier: 2,000 requests/day, up to 3 alternative routes per request
# Profile: driving-car (Uganda road network)
# Without this key: demo sample routes are shown, clearly labelled DEMO.
ORS_API_KEY=your_openrouteservice_api_key

# ─── Geocoding ─────────────────────────────────────────────────────────────────
# Photon (photon.komoot.io) is used by default — no API key required.
# It is an OSM-based geocoder. Requests are debounced (400ms) and biased
# to Uganda's bounding box. Respect rate limits; do not scrape.
#
# To upgrade to MapTiler Geocoding (higher quotas, SLA):
#   1. Create an account at https://cloud.maptiler.com/account/keys/
#   2. Set MAPTILER_API_KEY below
#   3. Implement a MapTilerGeocodingRepository matching GeocodingRepository
#   4. Inject it in MapStateController constructor
#
# Without a MapTiler key: Photon (free) is used automatically.
MAPTILER_API_KEY=

# ─── Environment ───────────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development
